{"nodes": [{"id": "semana_3_07_gfs01_v03_doc", "label": "GFS - Sistema de Archivos de Google (PDF)", "file_type": "document", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_gfs", "label": "Google File System (GFS)", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Dise\u00f1o acoplado a las cargas de trabajo del cliente y basado en hardware b\u00e1sico masivo con tolerancia a fallos, lo que lo volvi\u00f3 un sistema cr\u00edtico para Google.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_master", "label": "Master (nodo \u00fanico de metadatos)", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_chunkserver", "label": "Chunkserver", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_chunk", "label": "Chunk (64 MB, id de 64 bits, 3 r\u00e9plicas, bloques de 64 KB con checksum)", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": null, "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_metadata", "label": "Metadata del sistema de archivos (namespace, file-to-chunk, r\u00e9plicas)", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Todos los metadatos se almacenan en memoria: con ~64 bytes por chunk y archivos muy grandes el n\u00famero total de archivos es bajo, lo que optimiza enormemente las operaciones de metadatos.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_operation_log", "label": "Operation Log", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Garantiza una timeline l\u00f3gica coherente de las mutaciones y permite restaurar el master reproduciendo el log, evitando dejar metadatos da\u00f1ados ante operaciones fallidas.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_checkpoints", "label": "Checkpoints", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Permiten truncar el operation log y acelerar la restauraci\u00f3n del estado del master.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_chunk_leases", "label": "Chunk Leases (arrendamiento)", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "El master delega el orden serializado de mutaciones en la r\u00e9plica primaria mediante leases para no involucrarse en las operaciones de datos; adem\u00e1s desacopla el flujo de datos de la determinaci\u00f3n del orden, permitiendo optimizar la red por topolog\u00eda.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_consistency_model", "label": "Consistency Model (consistent / defined / undefined)", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se relaja el modelo de consistencia porque se comprenden a fondo las workloads del cliente (escrituras por append, checkpoints y logs autovalidados).", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_record_appends", "label": "Atomic record appends", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Ampliamente usado para implementar acceso concurrente: append at\u00f3mico al menos una vez en un offset elegido por GFS.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_replica_placement", "label": "Replica Placement", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Se evita crear muchas r\u00e9plicas a la vez en el mismo chunkserver porque los clientes transmiten grandes escrituras a chunks nuevos (evita puntos calientes); distribuir r\u00e9plicas entre racks a\u00f1ade tolerancia a fallos.", "_origin": "semantic"}, {"id": "semana_3_07_gfs01_v03_desacoplamiento", "label": "Desacoplamiento del flujo de datos y el control", "file_type": "concept", "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Separar metadatos (master) de datos (chunkservers) evita que el master \u00fanico sea un cuello de botella y simplifica namespace, colocaci\u00f3n y replicaci\u00f3n.", "_origin": "semantic"}], "edges": [{"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_gfs", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_master", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_chunkserver", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_chunk", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_metadata", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_operation_log", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_checkpoints", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_chunk_leases", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": "semana_3_07_gfs01_v03_doc", "target": "semana_3_07_gfs01_v03_consistency_model", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "semana_3/07 GFS01_v03.pdf", "source_location": null, "weight": 1.0, "_origin": "semantic"}, {"source": 